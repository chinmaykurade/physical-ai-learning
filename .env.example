# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   cp .env.example .env
#
# scripts/train_pusht_toy.sh sources .env automatically when WANDB_API_KEY is
# not already exported.

# Weights & Biases — https://wandb.ai/authorize
# Canonical project for this repo is `so101-embodied-ai` (set by the scripts,
# not here). On RunPod, do NOT paste the key into the pod: store it under
# Settings -> Secrets as `wandb_api_key`, then set the pod environment
# variable WANDB_API_KEY = {{ RUNPOD_SECRET_wandb_api_key }}
WANDB_API_KEY=

# Hugging Face — https://huggingface.co/settings/tokens  (needs WRITE scope)
# Not needed to *read* public datasets like lerobot/pusht. Required for
# `train_pusht_toy.sh --push`, for publishing datasets (Phase B, goal G3), and
# for gated model weights.
#
# Locally you can instead run `hf auth login`, which caches a token under
# ~/.cache/huggingface — that is why pushing works on this machine with no
# HF_TOKEN set. A pod has no such cache, so there the env var is required:
# store the token under Settings -> Secrets as `hf_token`, then set the pod
# environment variable HF_TOKEN = {{ RUNPOD_SECRET_hf_token }}
# HF_TOKEN=
